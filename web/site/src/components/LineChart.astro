---
interface Row {
  year: number;
  pct: number;
  series?: string;
  n?: number;
}
interface FilterOption {
  label: string;
  data: Row[];
}
interface Props {
  id: string;
  data: Row[];
  yLabel?: string;
  yMax?: number;
  filterOptions?: FilterOption[];
  filterLabel?: string;
}
const {
  id,
  data,
  yLabel = '% with declared dependencies',
  yMax,
  filterOptions,
  filterLabel,
} = Astro.props;
---

<div class="chart-wrap">
  {
    filterOptions && (
      <label class="body-sm chart-filter">
        {filterLabel}
        <select data-chart-filter-for={id}>
          {filterOptions.map((f, i) => (
            <option value={i}>{f.label}</option>
          ))}
        </select>
      </label>
    )
  }
  <div
    id={id}
    class="chart chart--line"
    data-payload={JSON.stringify(data)}
    data-y-label={yLabel}
    data-y-max={yMax ?? undefined}
    data-filter-options={filterOptions ? JSON.stringify(filterOptions) : undefined}
  >
  </div>
</div>

<script>
  import * as Plot from '@observablehq/plot';

  interface Row {
    year: number;
    pct: number;
    series?: string;
    n?: number;
  }

  function renderLineChart(el: HTMLElement, data: Row[]) {
    const yLabel = el.dataset.yLabel || '% with declared dependencies';
    const dataMax = Math.max(0, ...data.map((d) => d.pct));
    const yMax = Number(el.dataset.yMax) || Math.max(5, Math.ceil((dataMax * 1.15) / 5) * 5);
    const seriesNames = [...new Set(data.map((d) => d.series).filter((s) => s !== undefined))];
    const multi = seriesNames.length > 0;
    const color = multi
      ? {
          legend: true,
          domain: seriesNames,
          range: seriesNames.map((_, i) => `var(--chart-${(i % 7) + 1})`),
        }
      : undefined;
    const stroke = multi ? 'series' : 'var(--chart-1)';
    const tipTitle = (d: Row) =>
      [
        d.series,
        String(d.year),
        `${d.pct}%`,
        d.n !== undefined && `${d.n.toLocaleString()} repos`,
      ]
        .filter(Boolean)
        .join('\n');
    const tipOptions = { x: 'year', y: 'pct', title: tipTitle };
    const plot = Plot.plot({
      width: el.clientWidth || 640,
      height: 340,
      marginLeft: 50,
      // Tip fill and text follow the theme, not Plot's white default.
      style: '--plot-background: var(--color-card-bg); color: var(--color-text)',
      x: { label: 'Repo creation year', tickFormat: (d: number) => String(d) },
      y: { label: yLabel, domain: [0, yMax] },
      color,
      marks: [
        Plot.lineY(data, { x: 'year', y: 'pct', stroke, strokeWidth: 2 }),
        Plot.dot(data, { x: 'year', y: 'pct', fill: multi ? 'series' : 'var(--chart-1)' }),
        Plot.ruleY([0]),
        Plot.tip(data, multi ? Plot.pointer(tipOptions) : Plot.pointerX(tipOptions)),
      ],
    });
    el.replaceChildren(plot);
  }

  // Wire filter dropdowns immediately (not gated on visibility) -- a user can
  // reach the <select> before its chart has scrolled into view.
  document.querySelectorAll<HTMLElement>('.chart--line').forEach((el) => {
    const filterOptions = el.dataset.filterOptions
      ? JSON.parse(el.dataset.filterOptions)
      : null;
    if (!filterOptions) return;
    const select = document.querySelector<HTMLSelectElement>(
      `[data-chart-filter-for="${el.id}"]`,
    );
    select?.addEventListener('change', () => {
      renderLineChart(el, filterOptions[Number(select.value)].data);
      observer.unobserve(el);
    });
  });

  // Lazy-render on first visibility.
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      renderLineChart(el, JSON.parse(el.dataset.payload || '[]'));
      observer.unobserve(el);
    });
  });
  document.querySelectorAll<HTMLElement>('.chart--line').forEach((el) => observer.observe(el));
</script>

<style>
  .chart {
    min-height: 340px;
  }
</style>
