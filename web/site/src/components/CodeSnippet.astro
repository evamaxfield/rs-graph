---
// Highlighted code block with a copy button. Query snippets come verbatim from
// data-prep/queries/*.py via web/data-prep/extract_snippets.py; never hand-retype them.
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
}
const { code, lang = 'python' } = Astro.props;
---

<div class="snippet-wrap">
  <button type="button" class="snippet-copy" aria-live="polite">Copy</button>
  <div class="snippet">
    <Code
      code={code}
      lang={lang}
      themes={{ light: 'github-light', dark: 'github-dark-dimmed' }}
      defaultColor={false}
      wrap
    />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.snippet-copy').forEach((btn) => {
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const pre = btn.parentElement?.querySelector('pre');
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = 'Copy';
      }, 1500);
    });
  });
</script>

<style>
  .snippet-wrap {
    position: relative;
  }
  .snippet {
    font-size: 0.8rem;
    max-height: 24rem;
    overflow: auto;
    border-radius: 6px;
    border: 1px solid var(--color-border);
  }
  .snippet :global(pre) {
    margin: 0;
    padding: 1rem;
  }
  @media (max-width: 600px) {
    .snippet :global(pre) {
      padding-top: 2.5rem;
    }
  }
  .snippet-copy {
    position: absolute;
    top: 0.5rem;
    right: 1.25rem;
    z-index: 1;
    padding: 0.2rem 0.6rem;
    font: inherit;
    font-size: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-card-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  .snippet-copy:hover {
    border-color: var(--color-brand);
  }
  .snippet-copy:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 1px;
  }
</style>
