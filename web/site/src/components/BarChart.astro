---
interface FilterOption {
  label: string;
  data: { name: string; count: number; [key: string]: unknown }[];
}
interface Props {
  id: string;
  data: { name: string; count: number; [key: string]: unknown }[];
  xLabel?: string;
  colorField?: string;
  filterOptions?: FilterOption[];
  filterLabel?: string;
}
const { id, data, xLabel = 'Distinct repositories', colorField, filterOptions, filterLabel } =
  Astro.props;
---

<div class="chart-wrap">
  {filterOptions && (
    <label class="body-sm chart-filter">
      {filterLabel}
      <select data-chart-filter-for={id}>
        {filterOptions.map((f, i) => <option value={i}>{f.label}</option>)}
      </select>
    </label>
  )}
  <div
    id={id}
    class="chart chart--bar"
    data-payload={JSON.stringify(data)}
    data-x-label={xLabel}
    data-color-field={colorField}
    data-filter-options={filterOptions ? JSON.stringify(filterOptions) : undefined}
  ></div>
</div>

<script>
  import * as Plot from '@observablehq/plot';

  const PALETTE = [
    'var(--chart-1)', 'var(--chart-2)', 'var(--chart-3)', 'var(--chart-4)',
    'var(--chart-5)', 'var(--chart-6)', 'var(--chart-7)',
  ];

  function renderBarChart(el: HTMLElement, data: { name: string; count: number }[]) {
    const xLabel = el.dataset.xLabel || 'Distinct repositories';
    const colorField = el.dataset.colorField;
    const sorted = [...data].sort((a, b) => b.count - a.count);
    const plot = Plot.plot({
      width: el.clientWidth || 640,
      height: Math.max(240, sorted.length * 34),
      marginLeft: 110,
      marginRight: colorField ? 140 : 20,
      x: { label: xLabel },
      y: { label: null },
      color: colorField ? { legend: true, range: PALETTE } : undefined,
      marks: [
        Plot.barX(sorted, {
          x: 'count',
          y: 'name',
          fill: colorField || '#0250bb',
          sort: { y: '-x' },
        }),
        Plot.ruleX([0]),
      ],
    });
    el.replaceChildren(plot);
  }

  // Wire filter dropdowns immediately (not gated on visibility) -- a user can
  // reach the <select> before its chart has scrolled into view, and changing
  // it should render on demand regardless of the lazy-render observer below.
  document.querySelectorAll<HTMLElement>('.chart--bar').forEach((el) => {
    const filterOptions = el.dataset.filterOptions ? JSON.parse(el.dataset.filterOptions) : null;
    if (!filterOptions) return;
    const select = document.querySelector<HTMLSelectElement>(`[data-chart-filter-for="${el.id}"]`);
    select?.addEventListener('change', () => {
      renderBarChart(el, filterOptions[Number(select.value)].data);
      observer.unobserve(el);
    });
  });

  // Lazy-render on first visibility, so hidden tab panels don't mount every
  // chart's Plot instance up front.
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      renderBarChart(el, JSON.parse(el.dataset.payload || '[]'));
      observer.unobserve(el);
    });
  });
  document.querySelectorAll<HTMLElement>('.chart--bar').forEach((el) => observer.observe(el));
</script>

<style>
  .chart {
    min-height: 240px;
  }
</style>
