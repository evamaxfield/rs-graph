---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeSnippet from '../components/CodeSnippet.astro';
import DataTable from '../components/DataTable.astro';
import { withBase } from '../lib/url';
import { CITATION_TEXT, CITATION_BIBTEX } from '../lib/citation';

import homeStats from '../../public/data/home_stats.json';
import homeSamples from '../../public/data/home_samples.json';
import loadSnippet from '../generated/load_rs_graph.py.txt?raw';

const fmt = (n: number) => n.toLocaleString('en-US');
const sampleColumns = (columns: string[]) => columns.map((key) => ({ key, label: key }));
const loaderLines = Math.round(loadSnippet.trimEnd().split('\n').length / 10) * 10;

const usageSnippet = `# pip install datasets polars, then save the loader below as load_rs_graph.py
from load_rs_graph import load_filtered_pairs, load_table

pairs = load_filtered_pairs()                # article–repository pairs, recommended filters applied
pairs.select("document_doi", "document_title", "repository_url").head()
imports = load_table("repository_import")    # any table, by name`;
---

<BaseLayout title="Home">
  <div class="container home">
    <section class="hero">
      <h1 class="hero__title">Research papers, linked to their code</h1>
      <p class="body-lg">
        RS-Graph links {fmt(homeStats.n_documents)} scientific articles to the {
          fmt(homeStats.n_repositories)
        } GitHub repositories that store their code, forming {fmt(homeStats.n_links)} article–repository
        pairs. Each pair comes with bibliometric information, metadata, and details about the article's
        authors and the repository's code contributors.
      </p>
      <p class="body-lg">
        Access to each repository lets you study the code researchers create. We also processed
        that code to understand the software researchers use: the libraries each repository
        imports (<code>repository_import</code>) and the dependencies it declares (<code
          >repository_dependency</code
        >). And we joined each article to its software mentions from SoftCite-2025 (<code
          >document_software_mention</code
        >), so you can see what a paper says it used beside what its code uses.
      </p>
      <div class="hero__ctas">
        <a class="btn" href="#get-the-data">Get the data</a>
        <a class="btn btn--secondary" href={withBase('/docs')}>Read the docs</a>
      </div>
    </section>

    <section class="stats" aria-label="Dataset size">
      <div class="stat-tile">
        <span class="value">{fmt(homeStats.n_documents)}</span>
        <span class="label">articles</span>
      </div>
      <div class="stat-tile">
        <span class="value">{fmt(homeStats.n_repositories)}</span>
        <span class="label">repositories</span>
      </div>
      <div class="stat-tile">
        <span class="value">{fmt(homeStats.n_links)}</span>
        <span class="label"
          >article–repository pairs<sup><a href="#fn1" id="fnref1">1</a></sup></span
        >
      </div>
    </section>

    <p class="notification">
      Pairs beyond the five seed sources were found by mining the graph with our
      Article–Repository Matching Model (ARMM), which you can run on your own candidates.
      <a href={withBase('/docs#built')}>How RS-Graph was built</a>
    </p>

    <section id="get-the-data">
      <h2>Get the data</h2>
      <p>
        RS-Graph v2 is on HuggingFace as <a
          href="https://huggingface.co/datasets/sci-soft-collections/rs-graph-v2"
          ><code>sci-soft-collections/rs-graph-v2</code></a
        >, under CC BY 4.0<sup><a href="#fn2" id="fnref2">2</a></sup>. A gated variant, <a
          href="https://huggingface.co/datasets/sci-soft-collections/rs-graph-v2-full"
          ><code>sci-soft-collections/rs-graph-v2-full</code></a
        >, adds article abstracts and developers' names and emails. Request access on its
        HuggingFace page.
      </p>
      <p>
        Each table is one HuggingFace config. Any one loads with <code
          >load_dataset("sci-soft-collections/rs-graph-v2", "document", split="train")</code
        >.
      </p>
      <p>To pin your copy, pass <code>revision="v2.0"</code>.</p>

      <CodeSnippet code={usageSnippet} />

      <details class="loader">
        <summary>Show <code>load_rs_graph.py</code> (about {loaderLines} lines)</summary>
        <CodeSnippet code={loadSnippet} />
      </details>
      <p>
        The same file is printed on the <a
          href="https://huggingface.co/datasets/sci-soft-collections/rs-graph-v2"
          >dataset card</a
        >. <code>load_filtered_pairs()</code> keeps pairs with confidence ≥ 0.9994 or a curated link,
        and articles published in 2008 or later. <a href={withBase('/docs#filters')}
          >Why these filters</a
        >.
      </p>

      <h3>A sample of <code>pairs</code></h3>
      <DataTable
        id="sample-pairs"
        columns={sampleColumns(homeSamples.pairs.columns)}
        rows={homeSamples.pairs.rows}
        searchKeys={[]}
      />
      <h3>A sample of <code>imports</code></h3>
      <DataTable
        id="sample-imports"
        columns={sampleColumns(homeSamples.imports.columns)}
        rows={homeSamples.imports.rows}
        searchKeys={[]}
      />
      <p class="muted">
        10 random rows (fixed seed) from the frames above. Scroll sideways for every column.
      </p>
    </section>

    <section id="cite">
      <h2>Cite</h2>
      <p>If you use RS-Graph, please cite:</p>
      <p class="cite-text">{CITATION_TEXT}</p>
      <p class="muted">Citation coming soon.</p>
      <CodeSnippet code={CITATION_BIBTEX} lang="bibtex" />
      <p>Please also note the dataset revision you used, e.g. <code>v2.0</code>.</p>
    </section>

    <section class="footnotes">
      <h2>Footnotes</h2>
      <ol>
        <li id="fn1">
          Counts use the recommended filters. <a href={withBase('/docs#filters')}>Details</a>.
        </li>
        <li id="fn2">
          Rows from Papers with Code are CC BY-SA. READMEs, repository descriptions and
          software-mention snippets keep their original terms. See the <a
            href="https://huggingface.co/datasets/sci-soft-collections/rs-graph-v2"
            >dataset card</a
          >.
        </li>
        <li id="fn3">
          rs-graph-v1, used in "<a href="https://doi.org/10.1162/QSS.a.465"
            >Code Contribution and Credit in Science</a
          >", is available on <a href="https://doi.org/10.7910/DVN/KPYVI1">Harvard Dataverse</a
          >.
        </li>
        <li id="fn4">
          Want to add a source, share ARMM results on a new source, or fix an error? <a
            href="https://github.com/evamaxfield/rs-graph/issues">Open an issue</a
          >. <a href={withBase('/docs#contribute')}>How to contribute</a>.
        </li>
        <li id="fn5">
          To ask for a record to be removed, <a
            href="https://github.com/evamaxfield/rs-graph/issues">open an issue</a
          > (same as the dataset card's takedown section).
        </li>
        <li id="fn6">
          Worked examples are on <a href={withBase('/examples')}>Examples</a>. You can browse
          every pair on <a href={withBase('/explore')}>Browse pairs</a>.
        </li>
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 56rem;
  }
  .home h2 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin: 3rem 0 1rem;
  }
  .home h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 2rem 0 0.5rem;
  }
  .home code {
    overflow-wrap: anywhere;
  }
  .hero {
    padding: 3rem 0 1.5rem;
  }
  .hero__title {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    margin: 0 0 1.5rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .stats .value {
    font-size: clamp(2rem, 8vw, 2.75rem);
    line-height: 1.1;
  }
  .stats .label {
    font-size: 1rem;
  }
  .cite-text {
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--color-text-muted);
  }
  .loader {
    margin: 1rem 0;
  }
  .loader summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.5rem 0;
  }
  .footnotes li {
    margin-bottom: 0.5rem;
    overflow-wrap: anywhere;
  }
  .footnotes {
    color: var(--color-text-muted);
  }
</style>
